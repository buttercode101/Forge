{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "forge": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --outDir dist",
    "test": "node --test dist/tests/*.test.js",
    "check": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "verify:release": "node tools/verify-release.mjs",
    "verify:web": "node tools/verify-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "description": "Evidence-backed project state and verification for AI-assisted software work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buttercode101/Forge.git"
  },
  "bugs": {
    "url": "https://github.com/buttercode101/Forge/issues"
  }
}
